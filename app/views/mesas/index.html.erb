<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Gerenciamento de Mesas</h3>
    <a href="<%= new_mesa_path %>" class="btn btn-primary">+ Nova Mesa</a>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-striped mb-0">
          <thead class="table-dark">
            <tr>
              <th>Código</th>
              <th>Mesa</th>
              <th>Capacidade</th>
              <th>Status</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @mesas.each do |m| %>
              <tr>
                <td><%= m.codigo_mesa %></td>
                <td><%= m.numero %></td>
                <td><%= "#{m.quant_pessoas} pessoas" %></td>
                <td>
                  <% status_class = case m.status.to_s.downcase
                     when "livre" then "badge bg-success"
                     when "reservado" then "badge bg-warning"
                     when "ocupado" then "badge bg-danger"
                     else "badge bg-secondary"
                  end %>
                  <span class="<%= status_class %>"><%= m.status %></span>
                </td>
                <td>
                  <div class="btn-group btn-group-sm" role="group">
                    <div class="btn-group btn-group-sm" role="group">
                  <%= link_to "Pedidos", mesa_pedidos_path(m), class: "btn btn-info" %>
                  <%= link_to "Editar", edit_mesa_path(m), class: "btn btn-warning" %>
    
                  <% if m.status == 'Ocupado' %>
                  <%= link_to "Fechar", fechar_conta_mesa_path(m), class: "btn btn-success" %>
                   <% end %>
    
                   <%= button_to "Excluir", mesa_path(m), method: :delete, 
                  class: "btn btn-danger", 
                  data: { turbo_confirm: "Tem certeza que deseja excluir a mesa #{m.numero}?" } %>
                        </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>