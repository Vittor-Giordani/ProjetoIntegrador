<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-12">
      <div class="card shadow">
        <div class="card-header bg-success text-white">
          <h4 class="mb-0">
            <i class="fas fa-receipt me-2"></i>
            Fechar Conta - Mesa <%= @mesa.numero %>
          </h4>
        </div>
        
        <div class="card-body">
          <div class="mb-4">
            <h5 class="text-primary mb-3">
              <i class="fas fa-list me-2"></i>
              Resumo do Pedido
            </h5>
            
            <% if @pedido.itens_pedidos.any? %>
              <div class="table-responsive">
                <table class="table table-sm table-hover">
                  <thead class="table-light">
                    <tr>
                      <th>Produto</th>
                      <th class="text-center">Qtd</th>
                      <th class="text-end">Valor Unit.</th>
                      <th class="text-end">Subtotal</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @pedido.itens_pedidos.each do |item| %>
                      <tr>
                        <td><%= item.produto.nome %></td>
                        <td class="text-center"><%= item.quantidade %></td>
                        <td class="text-end">R$ <%= number_with_precision(item.valor_un, precision: 2) %></td>
                        <td class="text-end">R$ <%= number_with_precision(item.subtotal, precision: 2) %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="alert alert-warning text-center">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Nenhum produto no pedido.
              </div>
            <% end %>
          </div>

          <div class="mb-4">
            <h5 class="text-primary mb-3">
              <i class="fas fa-info-circle me-2"></i>
              Informações da Mesa
            </h5>
            <div class="row">
              <div class="col-md-6">
                <strong>Número da Mesa:</strong> <%= @mesa.numero %>
              </div>
              <div class="col-md-6">
                <strong>Capacidade:</strong> <%= @mesa.quant_pessoas %> pessoas
              </div>
            </div>
          </div>

          <div class="border-top pt-3">
            <div class="row">
              <div class="col-md-6">
                <h5 class="text-success">
                  <i class="fas fa-calculator me-2"></i>
                  Total do Pedido:
                </h5>
              </div>
              <div class="col-md-6 text-end">
                <h3 class="text-success fw-bold">
                  R$ <%= number_with_precision(@pedido.total, precision: 2) %>
                </h3>
              </div>
            </div>
          </div>

          <div class="mb-4 mt-4 text-center">
            <%= button_to "Confirmar Fechamento da Conta", 
                  fechar_conta_mesa_path(@mesa), 
                  method: :post,
                  class: "btn btn-success btn-lg",
                  data: { turbo_confirm: "Confirmar fechamento da conta da mesa #{@mesa.numero}?" } %>
          </div>

          <div class="border-top pt-3">
            <div class="row">
              <div class="col-md-6">
                <%= link_to "Voltar para Pedidos", mesa_pedidos_path(@mesa), class: "btn btn-secondary" %>
              </div>
              <div class="col-md-6 text-end">
                <%= link_to "Voltar para Mesas", mesas_path, class: "btn btn-outline-primary" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
