<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow">
        <div class="card-header bg-warning text-white py-3">
          <div class="d-flex align-items-center">
            <i class="fas fa-user-edit fa-lg me-3"></i>
            <div>
              <h4 class="mb-0">Editar Garçom</h4>
              <small class="opacity-75">Atualize as informações do garçom</small>
            </div>
          </div>
        </div>
        
        <div class="card-body p-4">
          <%= form_with(model: @garcon, local: true) do |form| %>
            <% if @garcon.errors.any? %>
              <div class="alert alert-danger mb-4">
                <div class="d-flex align-items-center mb-2">
                  <i class="fas fa-exclamation-circle me-2"></i>
                  <h6 class="mb-0"><%= pluralize(@garcon.errors.count, "erro") %> impediram a atualização:</h6>
                </div>
                <ul class="mb-0 ps-3">
                  <% @garcon.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            
            <div class="mb-4">
              <div class="form-group">
                <%= form.label :nome, "Nome do Garçom", class: "form-label fw-bold mb-2" %>
                <%= form.text_field :nome, 
                    class: "form-control form-control-lg", 
                    required: true,
                    placeholder: "Digite o nome do garçom",
                    autofocus: true %>
              </div>
            </div>
            
            <div class="mb-4">
              <div class="card border-info">
                <div class="card-body">
                  <div class="d-flex align-items-center">
                    <i class="fas fa-id-card fa-lg text-info me-3"></i>
                    <div>
                      <h6 class="mb-1 text-info">Código do Garçom</h6>
                      <p class="mb-0">
                        <strong class="fs-5"><%= @garcon.codigo_garcom %></strong>
                        <br>
                        <small class="text-muted">Este código é gerado automaticamente e usado internamente pelo sistema.</small>
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-between pt-3 border-top">
              <%= link_to garcons_path, class: "btn btn-outline-secondary" do %>
                <i class="fas fa-arrow-left me-1"></i> Cancelar
              <% end %>
              
              <%= form.button type: "submit", class: "btn btn-warning px-4" do %>
                <i class="fas fa-save me-1"></i> Atualizar
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="card shadow mt-4">
        <div class="card-header bg-light py-3">
          <div class="d-flex align-items-center">
            <i class="fas fa-exclamation-triangle text-warning me-3"></i>
            <h6 class="mb-0">Ações Adicionais</h6>
          </div>
        </div>
        <div class="card-body">
          <% if @garcon.pedidos.any? %>
            <div class="alert alert-warning mb-0">
              <div class="d-flex align-items-start">
                <i class="fas fa-exclamation-circle mt-1 me-3"></i>
                <div>
                  <h6 class="alert-heading mb-2">Atenção!</h6>
                  <p class="mb-0">
                    Este garçom possui <strong><%= @garcon.pedidos.count %></strong> pedido(s) vinculado(s).
                    <br>
                    <small class="text-muted">A exclusão não é recomendada pois afetaria o histórico de pedidos.</small>
                  </p>
                </div>
              </div>
            </div>
          <% else %>
            <div class="d-grid">
              <%= button_to garcon_path(@garcon), 
                  method: :delete, 
                  class: "btn btn-outline-danger btn-lg",
                  form: { 
                    data: { 
                      turbo_confirm: "Tem certeza que deseja excluir o garçom '#{@garcon.nome}'?\n\nEsta ação não poderá ser desfeita." 
                    } 
                  } do %>
                <i class="fas fa-trash-alt me-2"></i> Excluir Garçom
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .form-control-lg {
    padding: 0.75rem 1rem;
    font-size: 1.1rem;
  }
  
  .card {
    border: 1px solid rgba(0, 0, 0, 0.125);
  }
  
  .card-header.bg-warning {
    background-color: #ffc107 !important;
  }
  
  .btn-warning {
    background-color: #ffc107;
    border-color: #ffc107;
    color: #212529;
  }
  
  .btn-warning:hover {
    background-color: #e0a800;
    border-color: #d39e00;
    color: #212529;
  }
  
  .border-top {
    border-top: 1px solid #dee2e6 !important;
  }
  
  .card.border-info {
    border-color: #0dcaf0 !important;
  }
  
  .btn-outline-danger:hover {
    background-color: #dc3545;
    color: white;
  }
  
  .d-grid {
    display: grid;
  }
</style>