<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3>
      <i class="fas fa-history me-2"></i>
      Logs do Sistema
    </h3>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
      <h5 class="mb-0">
        <i class="fas fa-filter me-2"></i>
        Filtros
      </h5>
    </div>
    <div class="card-body">
      <%= form_with url: logs_path, method: :get, local: true, class: "row g-3" do |f| %>
        <div class="col-md-4">
          <label class="form-label">Data Inicial</label>
          <%= date_field_tag :data_inicio, params[:data_inicio], 
              class: "form-control", 
              max: Date.today %>
        </div>
        
        <div class="col-md-4">
          <label class="form-label">Data Final</label>
          <%= date_field_tag :data_fim, params[:data_fim], 
              class: "form-control", 
              max: Date.today %>
        </div>
        
        <div class="col-md-4 d-flex align-items-end">
          <div class="btn-group w-100" role="group">
            <%= button_tag type: "submit", class: "btn btn-primary" do %>
              <i class="fas fa-search me-1"></i> Filtrar
            <% end %>
            
            <% if params[:data_inicio].present? || params[:data_fim].present? %>
              <%= link_to logs_path, class: "btn btn-outline-secondary" do %>
                <i class="fas fa-times me-1"></i> Limpar
              <% end %>
            <% end %>
          </div>
        </div>
        
        <div class="col-12 mt-2">
          <div class="d-flex gap-2">
            <%= link_to "Hoje", logs_path(data_inicio: Date.today, data_fim: Date.today), 
                class: "btn btn-sm btn-outline-primary #{'active' if params[:data_inicio] == Date.today.to_s && params[:data_fim] == Date.today.to_s}" %>
            
            <%= link_to "Últimos 7 dias", logs_path(data_inicio: 6.days.ago.to_date, data_fim: Date.today), 
                class: "btn btn-sm btn-outline-primary #{'active' if params[:data_inicio] == 6.days.ago.to_date.to_s && params[:data_fim] == Date.today.to_s}" %>
            
            <%= link_to "Este mês", logs_path(data_inicio: Date.today.beginning_of_month, data_fim: Date.today), 
                class: "btn btn-sm btn-outline-primary #{'active' if params[:data_inicio] == Date.today.beginning_of_month.to_s && params[:data_fim] == Date.today.to_s}" %>
            
            <%= link_to "Todos", logs_path, 
                class: "btn btn-sm btn-outline-secondary #{'active' unless params[:data_inicio].present?}" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if params[:data_inicio].present? || params[:data_fim].present? %>
    <div class="alert alert-info mb-3">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <i class="fas fa-info-circle me-2"></i>
          <% if params[:data_inicio].present? && params[:data_fim].present? %>
            Mostrando logs de <strong><%= l(params[:data_inicio].to_date) %></strong> até <strong><%= l(params[:data_fim].to_date) %></strong>
          <% elsif params[:data_inicio].present? %>
            Mostrando logs a partir de <strong><%= l(params[:data_inicio].to_date) %></strong>
          <% elsif params[:data_fim].present? %>
            Mostrando logs até <strong><%= l(params[:data_fim].to_date) %></strong>
          <% end %>
          <span class="badge bg-primary ms-2"><%= @logs.count %> registros</span>
        </div>
        <%= link_to "Limpar filtros", logs_path, class: "btn btn-sm btn-outline-info" %>
      </div>
    </div>
  <% end %>

  <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover table-striped mb-0" style="table-layout: fixed;">
            <thead class="table-dark" style="position: sticky; top: 0; z-index: 1;">
              <tr>
                <th style="width: 150px;">Data/Hora</th>
                <th style="width: 180px;">Usuário</th>
                <th style="width: 120px;">Ação</th>
                <th style="width: auto;">Detalhes</th>
              </tr>
            </thead>
            <tbody>
              <% if @logs.any? %>
                <% @logs.each do |log| %>
                  <tr>
                    <td style="width: 150px;">
                      <small class="text-muted">
                        <%= log.data_acao.strftime("%d/%m/%Y %H:%M") if log.data_acao %>
                      </small>
                    </td>
                    <td style="width: 180px; overflow: hidden; text-overflow: ellipsis;">
                      <code><%= log.email %></code>
                    </td>
                    <td style="width: 120px;">
                      <% 
                        badge_class = case log.acao.to_s.downcase
                          when /criou|criado|create|created|cadastrou/ then 'bg-success'
                          when /editou|editado|update|updated/ then 'bg-warning'
                          when /excluiu|excluído|delete|deleted/ then 'bg-danger'
                          when /login|entrou/ then 'bg-info'
                          when /logout|saiu/ then 'bg-secondary'
                          else 'bg-primary'
                        end
                      %>
                      <span class="badge <%= badge_class %>">
                        <%= log.acao %>
                      </span>
                    </td>
                    <td style="word-wrap: break-word;">
                      <span title="<%= log.detalhes %>" data-bs-toggle="tooltip">
                        <%= log.detalhes.truncate(80) if log.detalhes %>
                      </span>
                      
                      <% if log.detalhes && log.detalhes.length > 80 %>
                        <button type="button" 
                                class="btn btn-sm btn-link p-0 ms-1" 
                                data-bs-toggle="modal" 
                                data-bs-target="#logModal<%= log.id %>">
                          Ver mais
                        </button>
                        
                        <div class="modal fade" id="logModal<%= log.id %>" tabindex="-1">
                          <div class="modal-dialog">
                            <div class="modal-content">
                              <div class="modal-header">
                                <h5 class="modal-title">Detalhes do Log</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                              </div>
                              <div class="modal-body">
                                <div class="mb-3">
                                  <strong>Usuário:</strong> <%= log.email %>
                                </div>
                                <div class="mb-3">
                                  <strong>Ação:</strong> <%= log.acao %>
                                </div>
                                <div class="mb-3">
                                  <strong>Data/Hora:</strong> <%= log.data_acao.strftime("%d/%m/%Y %H:%M:%S") if log.data_acao %>
                                </div>
                                <div>
                                  <strong>Detalhes:</strong>
                                  <div class="mt-2 p-3 bg-light rounded" style="max-height: 300px; overflow-y: auto;">
                                    <%= simple_format(log.detalhes) %>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="4" class="text-center py-4">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">
                      <% if params[:data_inicio].present? || params[:data_fim].present? %>
                        Nenhum log encontrado para o período selecionado.
                      <% else %>
                        Nenhum log encontrado.
                      <% end %>
                    </p>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  
  <% if @logs.respond_to?(:total_pages) && @logs.total_pages > 1 %>
    <div class="d-flex justify-content-center mt-4">
      <nav>
        <ul class="pagination">
          <% if @logs.prev_page %>
            <li class="page-item">
              <%= link_to "Anterior", logs_path(page: @logs.prev_page), class: "page-link" %>
            </li>
          <% end %>

          <% (@logs.total_pages).times do |page| %>
            <li class="page-item <%= 'active' if @logs.current_page == page + 1 %>">
              <%= link_to page + 1, logs_path(page: page + 1), class: "page-link" %>
            </li>
          <% end %>

          <% if @logs.next_page %>
            <li class="page-item">
              <%= link_to "Próxima", logs_path(page: @logs.next_page), class: "page-link" %>
            </li>
          <% end %>
        </ul>
      </nav>
    </div>
  <% end %>

  <div class="row mt-4">
    <div class="col-md-3">
      <div class="card text-white bg-primary">
        <div class="card-body">
          <h5 class="card-title"><%= Log.count %></h5>
          <p class="card-text">Total de Logs</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-success">
        <div class="card-body">
          <h5 class="card-title"><%= Log.where("data_acao >= ?", Date.today).count %></h5>
          <p class="card-text">Hoje</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-warning">
        <div class="card-body">
          <h5 class="card-title"><%= Log.distinct.count(:email) %></h5>
          <p class="card-text">Usuários Únicos</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-info">
        <div class="card-body">
          <h5 class="card-title"><%= Log.distinct.count(:acao) %></h5>
          <p class="card-text">Tipos de Ação</p>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

<!-- Adicione este script para inicializar tooltips -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Tooltips
  var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
  var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl)
  })
  
  // Validação das datas
  const dataInicio = document.getElementById('data_inicio');
  const dataFim = document.getElementById('data_fim');
  
  if (dataInicio && dataFim) {
    dataInicio.addEventListener('change', function() {
      if (this.value) {
        dataFim.min = this.value;
      }
    });
    
    dataFim.addEventListener('change', function() {
      if (this.value && dataInicio.value && this.value < dataInicio.value) {
        alert('A data final não pode ser anterior à data inicial.');
        this.value = '';
      }
    });
  }
});
</script>