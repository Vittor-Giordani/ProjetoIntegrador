<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0 text-dark">
        <i class="fas fa-box text-primary me-2"></i>
        Produtos
      </h1>
      <p class="text-muted mb-0">Gerencie os produtos do seu cardápio</p>
    </div>
    <%= link_to new_product_path, class: "btn btn-primary" do %>
      <i class="fas fa-plus-circle me-2"></i> Novo Produto
    <% end %>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-2"></i>
      <%= flash[:notice] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-triangle me-2"></i>
      <%= flash[:alert] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <div class="card border-0 shadow-lg">
    <div class="card-body p-0">
      <% if @products.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="py-3 px-4">Código</th>
                <th class="py-3 px-4">Nome</th>
                <th class="py-3 px-4">Tipo</th>
                <th class="py-3 px-4 text-end">Valor</th>
                <th class="py-3 px-4">Status</th>
                <th class="py-3 px-4 text-center">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% @products.each do |product| %>
                <tr>
                  <td class="py-3 px-4">
                    <span class="badge bg-primary bg-opacity-10 text-primary">
                      #<%= product.codigo_produto.to_s.rjust(3, '0') %>
                    </span>
                  </td>
                  <td class="py-3 px-4">
                    <strong><%= product.nome %></strong>
                  </td>
                  <td class="py-3 px-4">
                    <span class="badge bg-info bg-opacity-10 text-info">
                      <%= product.tipo %>
                    </span>
                  </td>
                  <td class="py-3 px-4 text-end fw-bold">
                    R$ <%= number_to_currency(product.valor, unit: '', separator: ',', delimiter: '.') %>
                  </td>
                  <td class="py-3 px-4">
                    <span class="badge bg-<%= product.status == 'ativo' ? 'success' : 'secondary' %>">
                      <%= product.status == 'ativo' ? 'Ativo' : 'Inativo' %>
                    </span>
                  </td>
                  <td class="py-3 px-4 text-center">
                    <div class="btn-group btn-group-sm" role="group">
                      <%= link_to edit_product_path(product), class: "btn btn-outline-warning" do %>
                        <i class="fas fa-edit me-1"></i> Editar
                      <% end %>
                      <%= button_to product_path(product), method: :delete, 
                          class: "btn btn-outline-danger",
                          form: { data: { turbo_confirm: "Excluir produto '#{product.nome}'?" } } do %>
                        <i class="fas fa-trash me-1"></i> Excluir
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="fas fa-box fa-3x text-muted opacity-25 mb-3"></i>
          <h5 class="text-muted">Nenhum produto cadastrado</h5>
          <p class="text-muted mb-4">Comece cadastrando seu primeiro produto</p>
          <%= link_to new_product_path, class: "btn btn-primary" do %>
            <i class="fas fa-plus-circle me-2"></i> Cadastrar Produto
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>