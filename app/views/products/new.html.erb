<div class="container mt-4">

  <h3>Novo Produto</h3>

  <div class="card shadow-sm mt-3">
    <div class="card-body">

      <%= form_with(model: @product, local: true) do |f| %>

        <div class="mb-3">
          <%= f.label :nome, "Nome do Produto" %>
          <%= f.text_field :nome, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :tipo, "Tipo" %>
          <%= f.text_field :tipo, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :valor, "Valor" %>
          <%= f.number_field :valor, step: "0.01", class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :status, "Status" %>
          <%= f.select :status, ["ativo", "inativo"], {}, class: "form-select" %>
        </div>

        <%= link_to "Voltar", dashboard_produtos_path, class: "btn btn-secondary ms-2" %>
        <%= f.submit "Salvar", class: "btn btn-success" %>
      <% end %>

    </div>
  </div>

</div>
