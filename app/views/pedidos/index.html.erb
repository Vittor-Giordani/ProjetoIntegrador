<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
      <i class="fas fa-utensils me-2"></i>
      Pedidos - Mesa <%= @mesa.numero %>
    </h2>
    <div>
      <%= link_to "Voltar para Mesas", mesas_path, class: "btn btn-secondary me-2" %>
      <% if @pedido.itens_pedidos.any? %>
        <%= button_to "Fechar Conta", fechar_conta_mesa_path(@mesa), method: :post, 
                      class: "btn btn-success", 
                      data: { turbo_confirm: "Fechar conta da mesa #{@mesa.numero}?" } %>
      <% end %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">
        <i class="fas fa-plus-circle me-2"></i>
        Adicionar Produto
      </h5>
    </div>
    <div class="card-body">
      <%= form_with url: mesa_pedidos_path(@mesa), method: :post do |form| %>
        <div class="row g-3 align-items-end">
          <div class="col-md-6">
            <%= form.label :produto_id, "Produto", class: "form-label fw-bold" %>
            <%= form.collection_select :produto_id, @produtos, :codigo_produto, :nome, 
                                      { include_blank: "Selecione um produto..." }, 
                                      { class: "form-select", required: true } %>
          </div>
          <div class="col-md-3">
            <%= form.label :quantidade, "Quantidade", class: "form-label fw-bold" %>
            <%= form.number_field :quantidade, value: 1, min: 1, class: "form-control" %>
          </div>
          <div class="col-md-3">
            <%= form.submit "Adicionar", class: "btn btn-primary w-100" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Lista de produtos do pedido -->
  <div class="card">
    <div class="card-header bg-dark text-white">
      <h5 class="mb-0">
        <i class="fas fa-list me-2"></i>
        Itens do Pedido
      </h5>
    </div>
    <div class="card-body p-0">
      <% if @pedido.itens_pedidos.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Produto</th>
                <th class="text-center">Quantidade</th>
                <th class="text-end">Valor Unitário</th>
                <th class="text-end">Subtotal</th>
                <th class="text-center">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% @pedido.itens_pedidos.each do |item| %>
                <tr>
                  <td><%= item.produto.nome %></td>
                  <td class="text-center"><%= item.quantidade %></td>
                  <td class="text-end">R$ <%= number_with_precision(item.valor_un, precision: 2) %></td>
                  <td class="text-end">R$ <%= number_with_precision(item.subtotal, precision: 2) %></td>
                  <td class="text-center">
                    <%= button_to "Remover", "/itens_pedidos/#{item.id}", 
                                  method: :delete, 
                                  class: "btn btn-sm btn-outline-danger",
                                  data: { turbo_confirm: "Remover #{item.produto.nome} do pedido?" } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot class="table-dark">
              <tr>
                <td colspan="3" class="text-end"><strong>Total Geral:</strong></td>
                <td class="text-end"><strong>R$ <%= number_with_precision(@pedido.total, precision: 2) %></strong></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
          <p class="text-muted mb-0">Nenhum produto adicionado ao pedido.</p>
          <small class="text-muted">Adicione produtos usando o formulário acima.</small>
        </div>
      <% end %>
    </div>
  </div>
</div>